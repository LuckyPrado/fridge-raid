# Copy to backend/.env and fill in. Never commit the real file.

# Google AI Studio key. Leave empty to run in offline mode (rule-based agents, no network).
GEMINI_API_KEY=

# Confirm the current Flash model ID in Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Tiger Data (Postgres) connection string. Leave empty to use a local SQLite file.
DATABASE_URL=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
